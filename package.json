{
  "name": "shop-backend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "node --watch src/server.ts",
    "type-check": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 --test-global-setup=test/global-setup.ts \"test/**/*.test.ts\"",
    "db:create": "node src/db/create-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "6.3.0",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "mysql2": "3.24.6",
    "typebox": "1.4.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
